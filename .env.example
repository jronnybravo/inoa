# ---------------------------------------------------------------------------
# Database - any that TypeORM supports.
#
# Either set the parts individually (works for every driver, including SQLite
# and hosts that hand you a socket), or set DATABASE_URL and let the scheme
# decide. DATABASE_URL wins when both are present.
# ---------------------------------------------------------------------------
DB_TYPE=postgres    # postgres | mysql | mariadb | sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=inoa
DB_PASSWORD=
DB_DATABASE=inoa
# DB_SSL=true       # defaults on for a remote host, off for localhost
# DB_SSL_REJECT_UNAUTHORIZED=false
#   Verifies the database's certificate, rather than merely encrypting the
#   connection without checking who is on the other end.
#
#   Its default follows how TLS was turned on. Setting DB_SSL yourself is
#   taken as a deliberate choice, so verification is ON unless you write
#   'false' here; TLS switched on implicitly by a remote host leaves it off.
#   Managed Postgres providers all present valid public-CA certificates, so
#   the only reason to write this line is a self-signed one.
#
# PGSSLMODE=require
# PGCHANNELBINDING=require
#   The two extra lines Neon's own snippet gives you. Both are honoured.
#
#   PGCHANNELBINDING is the one that used to be ignored, and it is a libpq
#   variable that node-postgres has never read — the driver will not offer
#   SCRAM-SHA-256-PLUS unless told to, so a database with
#   channel_binding=require refused the connection while this file looked
#   correctly filled in. It is asked for whenever TLS is on now. Write
#   'disable' to turn it off.
#
#   PGSSLMODE: disable | require | verify-ca | verify-full. DB_SSL above wins
#   over it where both are set.

# DB_USER and DB_NAME are accepted as aliases for DB_USERNAME and DB_DATABASE,
# so a .env carried over from another tool usually works unchanged.

# SQLite needs only these two:
#   DB_TYPE=sqlite
#   DB_DATABASE=./inoa.sqlite

# Or, instead of all of the above:
#   DATABASE_URL=postgresql://user:pass@host/inoa
#   DATABASE_URL=mysql://user:pass@host:3306/inoa
# On Neon use the POOLED string: a serverless function opening a direct
# connection per invocation exhausts Postgres connection slots.
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Generation - where the names come from.
#
# The order of preference:
#
#   1. A signed-in CLI. `claude login` once and you are done; a Codex CLI on
#      your PATH is used the same way. Several of them rotate - a batch each,
#      turn by turn - which spreads the rate limits and, more usefully, widens
#      the shortlist: a thousand names from one model is a thousand names with
#      one model's taste in them.
#   2. API keys, as failover. A subscription that hits its usage limit used to
#      end generation dead; with a key set it moves to the key instead.
#   3. Neither, and names are composed here instead - see INOA_AI below.
#
# The CLI leads on measurement, not principle: a batch of fifty names takes
# about 108 seconds through it, of which the process spawn and auth check are
# 5.5. Five per cent slower, and free rather than metered.
#
# Batches are shared only within the leading tier, so a working subscription is
# never quietly billed against a key sitting beside it. INOA_GENERATOR asks for
# both together when that is what you want.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Turn AI generation off entirely, whatever is configured above.
#
# Names are then composed from a thesaurus and a bundled word list: no key, no
# subscription, no cost, and the brief never leaves the building. Slower to
# read than a model's output and better than nothing by a wide margin - and
# for a brief you would rather not send anywhere, better than the alternative
# full stop.
#
# The same path runs automatically when nothing above is configured.
# INOA_AI=off

# Which source, and in what order. Overrides the preference and the membership
# both, so a machine with a subscription can still be told to use a key - and
# naming one of each is the only way to make them share the work.
# INOA_GENERATOR=claude-cli,codex-cli,anthropic,openai

# The model each source uses, if you want something other than its default.
# INOA_MODEL=               # the Claude CLI's own default when unset
# INOA_ANTHROPIC_MODEL=claude-opus-5
# INOA_OPENAI_MODEL=gpt-5.6
#   gpt-5.6 is an alias rather than a pinned snapshot, so it follows the line
#   as it moves. gpt-5.6-luna is the cheap end of that family and ample for
#   naming; gpt-6-astra is the capable end.

# ---------------------------------------------------------------------------
# Email - Resend sends verification codes and finished results.
#
# Optional. Leave it out and the form stops asking for an address: with no way
# to send a code there is nothing to verify, and nowhere to send results, so a
# run starts immediately and its page is where the results live. /runs is how
# you find that page again.
#
# Set it and verification comes back - an address proves itself once, and
# finished runs are emailed with the CSV attached.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxx
RESEND_FROM="Inoa <inoa@yourdomain.com>"

# Where the results email links back to. Point this at YOUR deployment - a run
# emails this address to whoever requested it, so a stale value sends people to
# somebody else's app.
PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# The web check - set at least one of these.
#
# Not strictly required, but close to it. Reading search engines over plain
# HTTP ships OFF (see the scraped tier below), which leaves a real browser
# driving Google as the only alternative - and that is challenged on sight from
# many addresses. Without a key here, expect a column of 'unverified'.
#
# Set as many as you like: the configured ones are used in ROTATION, so a run
# spreads across every allowance rather than draining one and then failing.
#
# Run `npm run doctor` once these are filled in. It asks each tier one question
# and tells you which would actually answer from your network, which is a lot
# cheaper than discovering it an hour into a run.
# ---------------------------------------------------------------------------
# Tavily - 1,000 searches/month, renews, NO CARD, so it cannot bill you.
TAVILY_API_KEY=
# Firecrawl - free monthly credits, no card.
FIRECRAWL_API_KEY=
# Exa - $10 of credit a month, no card.
EXA_API_KEY=
# Serper - 2,500 free once, then $0.30 per 1,000 (the cheapest paid option).
SERPER_API_KEY=
# Brave - free tier ended Feb 2026. Card required, $5 credit then $5 per 1,000.
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# The browser fallback, used only when no key above is set.
#
# Search engines punish volume without warning and the penalty outlasts the
# run, so the web check is deferred to a queue drained one name a minute. Both
# of these are IGNORED when any provider is configured, because then the check
# runs inline at a couple of seconds a name.
# ---------------------------------------------------------------------------
INOA_WEB_INTERVAL_MS=60000
# How long to stand down after Google signals it has had enough. Applies only
# to the browser queue; a provider hiccup can no longer trigger it.
INOA_WEB_BACKOFF_MS=1800000

# ---------------------------------------------------------------------------
# The scraped tier - OFF.
#
# Reading Bing and Google over plain HTTP is parked, not removed. Google cannot
# be scraped at all (Search requires JavaScript), Bing answers or serves
# unrelated results depending on the address, and the tier resolved about one
# check in 585 either way. `npm run doctor` probes both whether or not they are
# in use, so turn this on only if it reports one as 'usable'.
# ---------------------------------------------------------------------------
# INOA_SCRAPE_ENGINES=bing        # or bing,google
# Minimum gap between scrapes. A scraped engine is banned by RATE, so this is
# generous, and a name that cannot get a slot skips the tier rather than
# waiting. Governs nothing until the line above is uncommented.
# INOA_SCRAPE_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# Generation and pacing - all optional, defaults shown.
# ---------------------------------------------------------------------------
# Which model writes the names. Bulk text with no reasoning in it, so the
# largest model is not obviously the right one. Defaults to the CLI's own.
# INOA_MODEL=
# Names asked for per generation call. Small batches keep each request sharp:
# asked for a thousand at once a model repeats itself and drifts into filler.
# INOA_BATCH_SIZE=50
# Generation calls in flight at once. Bounded by your account's rate limit,
# not by this machine - each call only waits on the network.
# INOA_CONCURRENCY=5
# Names checked at once. About keeping the services' own limiters saturated
# rather than about local capacity.
# INOA_CHECK_CONCURRENCY=8

# How long to leave between two handle checks on the same platform. Unlike a
# domain, every handle check reaches the same host, and GitHub and X both
# throttle an unauthenticated caller.
# INOA_HANDLE_INTERVAL_MS=1200

# How long a verdict from an earlier run may be reused before the name is
# checked again. Names recur between runs, and re-checking one spends an Apple
# call, a Play scrape and a search credit to re-learn what is already recorded.
# Set to 0 to always check fresh.
INOA_REUSE_DAYS=14
