{
  "name": "branderist",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "worker": "node --experimental-strip-types worker/index.ts",
    "db:sync": "node --experimental-strip-types worker/sync-schema.ts",
    "recheck": "node --experimental-strip-types worker/recheck.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && prettier --check .",
    "worker:dev": "node --watch --experimental-strip-types worker/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@sveltejs/adapter-vercel": "^6.3.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.25.0",
    "typeorm": "^1.1.0",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.11.0"
  }
}
