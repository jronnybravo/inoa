---
/**
 * Slip 01 — the recording slip.
 *
 * The brief is the whole input; everything else is optional refinement, which
 * is why the textarea is the only thing above the fold of this slip and the
 * rest sits behind a disclosure band rather than in a form the user must
 * complete.
 */

import { EMOTIONS, PHILOSOPHY_CHOICES, TLD_CHOICES } from '../lib/options.ts';

const POSTURES = [
  { value: 'evoke', label: 'Evoke', hint: 'create a feeling, not explain the product' },
  { value: 'balanced', label: 'Balanced', hint: 'hint at the category, carry feeling' },
  { value: 'describe', label: 'Describe', hint: 'tell people what this is' },
];
---

<section class="slip" aria-labelledby="brief-heading">
  <span class="slip__index" aria-hidden="true">01</span>

  <div class="slip__head">
    <h2 class="notation notation--ink" id="brief-heading">The brief</h2>
    <p class="notation">Field 01 — required</p>
  </div>

  <form id="brief-form" novalidate>
    <label class="field">
      <span class="sr-only">What are you naming?</span>
      <textarea
        class="textarea"
        id="brief"
        name="brief"
        rows="3"
        maxlength="600"
        required
        placeholder="A calm, private assistant that organizes a family's shared life"
        autocomplete="off"></textarea>
      <p class="field__hint">
        One sentence about what it does and who it serves. Everything below is optional.
      </p>
    </label>

    <details class="advanced" id="advanced">
      <summary>Refine the brief</summary>
      <div class="advanced__body">
        <div class="field">
          <span class="notation field__label" id="emotions-label">Emotional target</span>
          <div class="ticks" role="group" aria-labelledby="emotions-label">
            {EMOTIONS.map((emotion) => (
              <label class="tick">
                <input type="checkbox" name="emotions" value={emotion} />
                {emotion}
              </label>
            ))}
          </div>
          <p class="field__hint">
            Drives both the concept search and the sound the engine reaches for. Pick two or three.
          </p>
        </div>

        <div class="grid-fields">
          <label class="field">
            <span class="notation field__label">Industry today</span>
            <input class="input" type="text" name="industry" maxlength="60" placeholder="fintech, health, dev" autocomplete="off" />
          </label>

          <label class="field">
            <span class="notation field__label">Audience</span>
            <input class="input" type="text" name="audience" maxlength="200" placeholder="who it is for" autocomplete="off" />
          </label>

          <label class="field">
            <span class="notation field__label">Posture</span>
            <select class="select" name="posture">
              {POSTURES.map((p) => (
                <option value={p.value}>{p.label} — {p.hint}</option>
              ))}
            </select>
          </label>

          <label class="field">
            <span class="notation field__label">Rule out</span>
            <input class="input" type="text" name="avoid" maxlength="120" placeholder="words to exclude, comma separated" autocomplete="off" />
          </label>

          <label class="field">
            <span class="notation field__label">Syllables</span>
            <select class="select" name="syllables">
              <option value="2-3">2–3 — the brand sweet spot</option>
              <option value="1-2">1–2 — short and punchy</option>
              <option value="2-4">2–4 — wider net</option>
              <option value="3-4">3–4 — longer, more formal</option>
            </select>
          </label>

          <label class="field">
            <span class="notation field__label">Finalists to verify</span>
            <select class="select" name="validate">
              <option value="5">5 names</option>
              <option value="8" selected>8 names</option>
              <option value="12">12 names</option>
              <option value="20">20 names</option>
              <option value="30">30 names</option>
            </select>
            <p class="field__hint">
              Above 12 needs a local run; a public instance caps it, because each
              finalist costs six lookups against public registries.
            </p>
          </label>

          <label class="field">
            <span class="notation field__label">Domain requirement</span>
            <select class="select" name="requireTld">
              <option value="none" selected>None — parked and for-sale domains are fine</option>
              <option value="com">Require .com unregistered</option>
              <option value="io">Require .io unregistered</option>
              <option value="ai">Require .ai unregistered</option>
              <option value="co">Require .co unregistered</option>
            </select>
            <p class="field__hint">
              Registry data cannot tell a parked or for-sale domain from one in
              active use, so requiring an unregistered domain also rejects names
              you could simply buy.
            </p>
          </label>

          <label class="field">
            <span class="notation field__label">Run seed</span>
            <input class="input" type="number" name="seed" min="1" max="2147483647" placeholder="random" />
            <p class="field__hint">
              Blank searches fresh ground each run. The seed used is shown with the
              results, so a run you like can be replayed.
            </p>
          </label>
        </div>

        <div class="field">
          <span class="notation field__label" id="strategies-label">Naming strategies</span>
          <div class="ticks ticks--stacked" role="group" aria-labelledby="strategies-label">
            {PHILOSOPHY_CHOICES.map((choice, index) => (
              <label class="tick tick--wide" title={choice.blurb}>
                <input
                  type="checkbox"
                  name="philosophies"
                  value={choice.value}
                  checked={index < 3}
                />
                <span>
                  {choice.label}
                  <em>{choice.blurb}</em>
                </span>
              </label>
            ))}
          </div>
          <p class="field__hint">
            Each selected strategy gets its own full cycle of generation and mutation.
            More strategies means a wider search and a longer run.
          </p>
        </div>

        <div class="field">
          <span class="notation field__label" id="stores-label">App stores</span>
          <div class="ticks" role="group" aria-labelledby="stores-label">
            <label class="tick tick--wide">
              <input type="checkbox" name="allowAppCollisions" value="true" />
              <span>
                Allow names already on the App Store or Play Store
                <em>Off by default: an existing listing outranks you in the one
                search that matters. Apple's answer is authoritative; Play has no
                public API and is read best-effort, so it can come back unknown.</em>
              </span>
            </label>
          </div>
        </div>

        <div class="field">
          <span class="notation field__label" id="tlds-label">Check domains</span>
          <div class="ticks" role="group" aria-labelledby="tlds-label">
            {TLD_CHOICES.map((tld) => (
              <label class="tick">
                <input
                  type="checkbox"
                  name="tlds"
                  value={tld}
                  checked={['com', 'io', 'ai', 'co'].includes(tld)}
                />
                .{tld}
              </label>
            ))}
          </div>
        </div>
      </div>
    </details>

    <div class="actions">
      <button class="btn btn--primary" type="submit" id="run">Run discovery</button>
      <button class="btn btn--secondary" type="button" id="example">Use an example brief</button>
      <p class="actions__cost" id="cost" aria-live="polite"></p>
    </div>
  </form>
</section>
